# 复制为 .env 后填入真实值。.env 已在 .gitignore 中排除，不要提交。
# 下面全部是可选项：缺省时对应能力自动跳过，不影响核心流程。

# ── 资产情报（第三方查询服务）──
FOFA_KEY=
ZOOMEYE_KEY=
SECURITYTRAILS_API_KEY=
SSLMATE_API_KEY=
VIRUSTOTAL_API_KEY=
# 只读公开代码检索（用于供应链 / 泄露面排查）
GITHUB_TOKEN=

# ── 大模型端点（任何 OpenAI 兼容服务）──
SRC_OPENAI_BASE_URL=
SRC_OPENAI_API_KEY=
SRC_OPENAI_MODEL=

# ── 通知（可选）──
FEISHU_BOT_TOKEN=
FEISHU_CHAT_ID=
